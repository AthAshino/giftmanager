# Copy to .env and adjust for your setup: cp .env.example .env
#
# Secrets (never written to disk by the app — only used from the environment):
SECRET_KEY=change-me-to-a-long-random-string
SMTP_PASSWORD=

# Optional SMTP mail system.
# Leave SMTP_HOST empty to disable email notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Sender address for outgoing emails (also used as the From header)
SYSTEM_EMAIL=

# Optional OIDC settings
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=
OIDC_LOGOUT_URL=

# Optional: public base URL of the app (e.g. https://gift.example.com).
# When set, it is used to build the OIDC redirect_uri and share links, so it
# must match exactly the Redirect URI registered in your IdP (Authentik):
#   https://gift.example.com/auth
# If unset, the URL is derived from the request's proxy headers (X-Forwarded-*).
PUBLIC_URL=

# Optional: default UI language (en, es, fr, nl, sv)
LANGUAGE=en
